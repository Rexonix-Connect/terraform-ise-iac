{% set r = resource.name %}

#
# ------------------------------------------------------------------
# {{ r | replace("_", " ") | upper() }} RANKS
# ------------------------------------------------------------------
#
# Ranks of {{ r | replace("_", " ") }} objects are applied in bulk after the
# objects exist. Objects without a rank and default objects are left as they are.
#

{% if group_ref %}
locals {
  # {{ r | replace("_", " ") | capitalize }} objects with a rank, grouped by {{ group_ref.name }}
  {{ r }}_ranks = {
    for item in local.{{ r }} : {{ group_key }} => item... if try(item.rank, null) != null && !try(item.default, false)
  }
}

resource "ise_{{ ranks.resource }}" "{{ ranks.resource }}" {
  for_each = local.{{ r }}_ranks

  {{ group_ref.attr }} = {{ group_value }}
  {{ ranks.list }} = [for item in each.value : {
    id   = ise_{{ r }}.{{ r }}[{{ key }}].id
    rank = item.rank
  }]
}
{% else %}
locals {
  # {{ r | replace("_", " ") | capitalize }} objects with a rank
  {{ r }}_ranks = [for item in local.{{ r }} : item if try(item.rank, null) != null && !try(item.default, false)]
}

resource "ise_{{ ranks.resource }}" "{{ ranks.resource }}" {
  count = length(local.{{ r }}_ranks) > 0 ? 1 : 0

  {{ ranks.list }} = [for item in local.{{ r }}_ranks : {
    id   = ise_{{ r }}.{{ r }}[{{ key }}].id
    rank = item.rank
  }]
}
{% endif %}
